<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.CutlogShell" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Web 側が画面全体を作るので、殻はタイトルバーを出さない -->
        <item name="android:windowBackground">#0f1113</item>
        <item name="colorPrimary">#3b82f6</item>
        <item name="colorAccent">#3b82f6</item>
    </style>

    <!-- 撮影中は素の黒。プレビュー以外の色を混ぜない。 -->
    <style name="Theme.CutlogShell.Capture" parent="Theme.CutlogShell">
        <item name="android:windowBackground">#000000</item>
    </style>
</resources>
