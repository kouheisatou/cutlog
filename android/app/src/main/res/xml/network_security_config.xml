<?xml version="1.0" encoding="utf-8"?>
<!--
  セルフホストが前提のアプリなので、LAN の http:// なサーバも指せるようにしてある。
  既定の接続先（tailscale の *.ts.net）はふつうに TLS が通るため、証明書の例外は入れていない。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
