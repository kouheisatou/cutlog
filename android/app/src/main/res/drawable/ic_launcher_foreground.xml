<?xml version="1.0" encoding="utf-8"?>
<!--
  時間の軸を抽象にしたしるし。白地に細い黒の線だけ。
  ・横一本が時間の流れ、縦の線が区切り。|—|—|— の形そのもの
  ・アダプティブアイコンは外周が切り落とされるので、絵は中央 72dp に収める
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 時間の軸 -->
    <path
        android:pathData="M25,54 h58"
        android:strokeColor="#101012"
        android:strokeWidth="1.9"
        android:strokeLineCap="round" />

    <!-- 区切りの刻み -->
    <path
        android:pathData="M25,46.5 v15 M44.3,46.5 v15 M63.7,46.5 v15 M83,46.5 v15"
        android:strokeColor="#101012"
        android:strokeWidth="1.9"
        android:strokeLineCap="round" />
</vector>
