{
  "name": "cutlog",
  "version": "0.1.0",
  "description": "セルフホスト可能なオープンソース版SetLog。ブラウザだけで完結する日常の記録アプリ。",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "vapid": "node scripts/gen-vapid.js",
    "lint": "node --check src/index.js && node scripts/lint.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "archiver": "^7.0.1",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "openid-client": "^6.8.7",
    "pg": "^8.23.0",
    "web-push": "^3.6.7"
  },
  "main": "src/index.js"
}
