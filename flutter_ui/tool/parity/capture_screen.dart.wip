// 撮影の画面。web/index.html の #captureDialog と、
// web/styles.css の「── 撮影 ──」の節を、寸法そのままで写したもの。
//
// 横（16:9）で撮るのが基本。縦持ちのときは、撮れる範囲だけを 16:9 の枠で見せ、
// 操作は正しい向きのまま下に置く——という web 側の考え方をそのまま引き継いでいる。
import 'dart:math' as math;

import 'package:flutter/material.dart';

import '../design/icons.dart';
import '../design/tokens.dart';

class CaptureScreen extends StatefulWidget {
  const CaptureScreen({super.key});

  @override
  State<CaptureScreen> createState() => _CaptureScreenState();
}

class _CaptureScreenState extends State<CaptureScreen> with SingleTickerProviderStateMixin {
  // 1カットの長さ。CSS の --cut-seconds（既定 2s）にあたる。
  static const Duration _cutLength = Duration(seconds: 2);

  // 端末が返してくるレンズの名前。web 側の LENS_ORDER と同じ並び。
  static const List<String> _lenses = <String>['自動', '0.5×', '1×', '望遠'];

  // よく使う倍率だけ。増やすと押しにくくなる。
  static const List<double> _zoomStops = <double>[1, 2, 4];

  late final AnimationController _ring = AnimationController(vsync: this, duration: _cutLength)
    ..addStatusListener((AnimationStatus status) {
      // 輪が一周したら、撮ったものを確かめる画面へ移る
      if (status == AnimationStatus.completed) setState(() => _reviewing = true);
    });

  String _lens = '自動';
  double _zoom = 1;
  bool _reviewing = false;

  bool get _recording => _ring.isAnimating;

  @override
  void dispose() {
    _ring.dispose();
    super.dispose();
  }

  void _shoot() {
    if (_recording) return;
    setState(() {});
    _ring.forward(from: 0);
  }

  void _retake() {
    _ring.reset();
    setState(() => _reviewing = false);
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: camBackdrop,
      body: Stack(
        children: <Widget>[
          // .cam-stage — 上下の帯は position:absolute なので、映像は画面いっぱいを取る
          const Positioned.fill(child: _CamStage()),

          // .capture-top
          Positioned(
            top: 0,
            left: 0,
            right: 0,
            child: _CaptureTop(showFlip: !_reviewing),
          ),

          // .capture-controls（撮ったあとは display:none で引っこむ）
          if (!_reviewing)
            Positioned(
              left: 0,
              right: 0,
              bottom: 0,
              child: _CaptureControls(
                lenses: _lenses,
                lens: _lens,
                onLens: (String v) => setState(() => _lens = v),
                zoom: _zoom,
                zoomStops: _zoomStops,
                onZoom: (double v) => setState(() => _zoom = v),
                ring: _ring,
                recording: _recording,
                onShoot: _shoot,
              ),
            ),

          // .review-bar
          if (_reviewing)
            Positioned(
              left: 0,
              right: 0,
              bottom: 0,
              child: _ReviewBar(onRetake: _retake),
            ),
        ],
      ),
    );
  }
}

// ── 映像の置き場 ────────────────────────────────────────
// CSS: .cam-stage { display:grid; place-items:center }
//      .cam-stage video { width:100%; height:100%; object-fit:contain }
// 撮れる範囲をそのまま見せるので、縦持ちでは上下に黒が残る（letterbox）。
class _CamStage extends StatelessWidget {
  const _CamStage();

  @override
  Widget build(BuildContext context) {
    return ColoredBox(
      color: camBackdrop,
      child: Center(
        child: AspectRatio(
          aspectRatio: 16 / 9,
          // ここに端末のカメラの映像が入る。いまは入る枠だけを置いてある。
          child: ColoredBox(color: const Color(0xFF17171A)),
        ),
      ),
    );
  }
}

// ── 上の帯 ──────────────────────────────────────────────
class _CaptureTop extends StatelessWidget {
  const _CaptureTop({required this.showFlip});

  final bool showFlip;

  @override
  Widget build(BuildContext context) {
    // CSS: padding: max(var(--s2), var(--sa-top)) var(--s3) var(--s2)
    final double safeTop = MediaQuery.paddingOf(context).top;

    return Container(
      padding: EdgeInsets.fromLTRB(s3, math.max(s2, safeTop), s3, s2),
      decoration: const BoxDecoration(
        // linear-gradient(to bottom, rgba(0,0,0,.55), transparent)
        gradient: LinearGradient(
          begin: Alignment.topCenter,
          end: Alignment.bottomCenter,
          colors: <Color>[Color(0x8C000000), Color(0x00000000)],
        ),
      ),
      child: Row(
        children: <Widget>[
          const _IconButtonLight(CutIcon.close),
          const SizedBox(width: s2),
          const Flexible(child: _CapDest('記録先 きょうのログ')),
          const SizedBox(width: s2),
          const Spacer(),
          if (showFlip) const _IconButtonLight(CutIcon.flip),
        ],
      ),
    );
  }
}

/// CSS: .icon-btn { width:44px; height:44px } + .icon-btn.light { color:#fff; opacity:.9 }
class _IconButtonLight extends StatelessWidget {
  const _IconButtonLight(this.icon);

  final CutIcon icon;

  @override
  Widget build(BuildContext context) {
    return SizedBox(
      width: 44,
      height: 44,
      child: Opacity(
        opacity: .9,
        child: Center(child: CutIconView(icon)),
      ),
    );
  }
}

/// CSS: .cap-dest — 等幅ではなく地の書体。下線は 4px 下げる。
class _CapDest extends StatelessWidget {
  const _CapDest(this.text);

  final String text;

  @override
  Widget build(BuildContext context) {
    return ConstrainedBox(
      constraints: const BoxConstraints(minHeight: 32),
      child: Align(
        alignment: Alignment.centerLeft,
        child: Opacity(
          opacity: .85,
          child: Text(
            text,
            maxLines: 1,
            overflow: TextOverflow.ellipsis,
            style: TextStyle(
              color: light,
              fontSize: 11,
              height: lineHeight,
              letterSpacing: tracking(11, .06),
              decoration: TextDecoration.underline,
              decorationColor: light,
            ),
          ),
        ),
      ),
    );
  }
}

// ── 下の操作 ────────────────────────────────────────────
class _CaptureControls extends StatelessWidget {
  const _CaptureControls({
    required this.lenses,
    required this.lens,
    required this.onLens,
    required this.zoom,
    required this.zoomStops,
    required this.onZoom,
    required this.ring,
    required this.recording,
    required this.onShoot,
  });

  final List<String> lenses;
  final String lens;
  final ValueChanged<String> onLens;
  final double zoom;
  final List<double> zoomStops;
  final ValueChanged<double> onZoom;
  final Animation<double> ring;
  final bool recording;
  final VoidCallback onShoot;

  @override
  Widget build(BuildContext context) {
    // CSS: padding: var(--s3) var(--s3) max(var(--s3), var(--sa-bottom))
    final double safeBottom = MediaQuery.paddingOf(context).bottom;

    return Container(
      padding: EdgeInsets.fromLTRB(s3, s3, s3, math.max(s3, safeBottom)),
      decoration: const BoxDecoration(
        // linear-gradient(to top, rgba(0,0,0,.6), transparent)
        gradient: LinearGradient(
          begin: Alignment.bottomCenter,
          end: Alignment.topCenter,
          colors: <Color>[Color(0x99000000), Color(0x00000000)],
        ),
      ),
      child: Column(
        mainAxisSize: MainAxisSize.min,
        crossAxisAlignment: CrossAxisAlignment.center,
        children: <Widget>[
          // .lens-list — 粒を横に並べる。入りきらなければ折り返す。
          Wrap(
            spacing: 6,
            runSpacing: 6,
            alignment: WrapAlignment.center,
            children: <Widget>[
              for (final String name in lenses)
                _Pill(
                  text: name,
                  active: name == lens,
                  minWidth: 46,
                  minHeight: 30,
                  horizontalPadding: 10,
                  fontSize: 10,
                  letterSpacing: tracking(10, .04),
                  onTap: () => onLens(name),
                ),
            ],
          ),
          const SizedBox(height: s2),

          // .zoom-row — 倍率・つまみ・目印の順
          _ZoomRow(zoom: zoom, stops: zoomStops, onZoom: onZoom),
          const SizedBox(height: s2),

          // .capture-bottom — grid-template-columns: 1fr auto 1fr
          ConstrainedBox(
            constraints: const BoxConstraints(maxWidth: 520),
            child: Row(
              children: <Widget>[
                const Expanded(child: Align(alignment: Alignment.centerLeft, child: _FileChip())),
                _Shutter(ring: ring, recording: recording, onTap: onShoot),
                const Expanded(
                  child: Align(alignment: Alignment.centerRight, child: _Chip('動画', opacity: .55)),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }
}

/// CSS: .lens / .zoom-stop — 形は同じで、大きさだけが違う。
class _Pill extends StatelessWidget {
  const _Pill({
    required this.text,
    required this.active,
    required this.minWidth,
    required this.minHeight,
    required this.horizontalPadding,
    required this.fontSize,
    required this.letterSpacing,
    this.onTap,
  });

  final String text;
  final bool active;
  final double minWidth;
  final double minHeight;
  final double horizontalPadding;
  final double fontSize;
  final double letterSpacing;
  final VoidCallback? onTap;

  @override
  Widget build(BuildContext context) {
    return GestureDetector(
      onTap: onTap,
      behavior: HitTestBehavior.opaque,
      child: Container(
        constraints: BoxConstraints(minWidth: minWidth, minHeight: minHeight),
        padding: EdgeInsets.symmetric(horizontal: horizontalPadding),
        alignment: Alignment.center,
        decoration: BoxDecoration(
          color: active ? light : pillBackdrop,
          borderRadius: BorderRadius.circular(999),
        ),
        child: Text(
          text,
          style: TextStyle(
            color: active ? pillActiveInk : light,
            fontFamily: monoFamily,
            fontFamilyFallback: monoFallback,
            fontSize: fontSize,
            height: lineHeight,
            letterSpacing: letterSpacing,
          ),
        ),
      ),
    );
  }
}

class _ZoomRow extends StatelessWidget {
  const _ZoomRow({required this.zoom, required this.stops, required this.onZoom});

  final double zoom;
  final List<double> stops;
  final ValueChanged<double> onZoom;

  // 端末が寄れる範囲は 1 から始まらないことがあるので、いちばん引いた状態を 1.0 として見せる
  static String _label(double v) {
    final String s = ((v * 10).round() / 10).toStringAsFixed(1);
    return s.endsWith('.0') ? s.substring(0, s.length - 2) : s;
  }

  @override
  Widget build(BuildContext context) {
    return ConstrainedBox(
      constraints: const BoxConstraints(maxWidth: 520),
      child: Row(
        children: <Widget>[
          // .zoom-now
          Container(
            constraints: const BoxConstraints(minWidth: 44),
            padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
            alignment: Alignment.center,
            decoration: BoxDecoration(
              color: pillBackdrop,
              borderRadius: BorderRadius.circular(999),
            ),
            child: Text(
              '${_label(zoom)}×',
              style: const TextStyle(
                color: light,
                fontFamily: monoFamily,
                fontFamilyFallback: monoFallback,
                fontSize: 11,
                height: lineHeight,
              ),
            ),
          ),
          const SizedBox(width: s2),

          // input[type=range]（accent-color:#fff）。
          // ★ 素の <input> をそのまま写すことはできないので、Safari の見え方に寄せてある。
          Expanded(
            child: SliderTheme(
              data: SliderThemeData(
                trackHeight: 4,
                activeTrackColor: light,
                inactiveTrackColor: const Color(0x47FFFFFF),
                thumbColor: light,
                overlayColor: const Color(0x1AFFFFFF),
                thumbShape: const RoundSliderThumbShape(enabledThumbRadius: 10),
                overlayShape: const RoundSliderOverlayShape(overlayRadius: 20),
                trackShape: const RoundedRectSliderTrackShape(),
              ),
              child: Slider(
                min: 1,
                max: 4,
                value: zoom.clamp(1, 4),
                onChanged: onZoom,
              ),
            ),
          ),
          const SizedBox(width: s2),

          // .zoom-stops
          Row(
            mainAxisSize: MainAxisSize.min,
            children: <Widget>[
              for (int i = 0; i < stops.length; i++) ...<Widget>[
                if (i > 0) const SizedBox(width: 4),
                _Pill(
                  text: '${_label(stops[i])}×',
                  // web 側は「刻みの半分」より近ければ選ばれている扱いにしている
                  active: (stops[i] - zoom).abs() < .05,
                  minWidth: 34,
                  minHeight: 28,
                  horizontalPadding: 6,
                  fontSize: 10,
                  letterSpacing: 0,
                  onTap: () => onZoom(stops[i]),
                ),
              ],
            ],
          ),
        ],
      ),
    );
  }
}

/// CSS: .chip — 等幅・大文字・字間 .14em。落ち影で映像から浮かせる。
class _Chip extends StatelessWidget {
  const _Chip(this.text, {this.opacity = .8});

  final String text;
  final double opacity;

  @override
  Widget build(BuildContext context) {
    return Opacity(
      opacity: opacity,
      child: Padding(
        padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 6),
        child: Text(
          text.toUpperCase(),
          style: TextStyle(
            color: light,
            fontFamily: monoFamily,
            fontFamilyFallback: monoFallback,
            fontSize: 11,
            height: lineHeight,
            letterSpacing: tracking(11, .14),
            shadows: <Shadow>[chipShadow],
          ),
        ),
      ),
    );
  }
}

/// CSS: .chip.file — 端末の動画から選ぶ。押せる範囲は 44px を確保する。
/// ★ .ic.sm には margin-right:8px が付いているので、中身は中心より少し左に寄る。
///   web と並べたときにずれて見えるので、その 8px もそのまま持ってきている。
class _FileChip extends StatelessWidget {
  const _FileChip();

  @override
  Widget build(BuildContext context) {
    return SizedBox(
      width: 44,
      height: 44,
      child: Opacity(
        opacity: .8,
        child: Center(
          child: Padding(
            padding: const EdgeInsets.only(right: s1),
            child: CutIconView.small(CutIcon.plus),
          ),
        ),
      ),
    );
  }
}

// ── シャッター ──────────────────────────────────────────
// CSS: .shutter は 78px の丸。中の赤い粒は 58px。
// 撮っているあいだ、外側の輪が時計回りに一周する。ちょうど1カットぶんの長さ。
class _Shutter extends StatelessWidget {
  const _Shutter({required this.ring, required this.recording, required this.onTap});

  final Animation<double> ring;
  final bool recording;
  final VoidCallback onTap;

  @override
  Widget build(BuildContext context) {
    // .shutter.recording .dot { width:26px; height:26px; border-radius:6px }
    final double dot = recording ? 26 : 58;
    final double radius = recording ? 6 : 29;

    return GestureDetector(
      onTap: onTap,
      behavior: HitTestBehavior.opaque,
      child: SizedBox(
        width: 78,
        height: 78,
        child: Stack(
          alignment: Alignment.center,
          children: <Widget>[
            Positioned.fill(
              child: AnimatedBuilder(
                animation: ring,
                builder: (BuildContext context, Widget? child) {
                  return CustomPaint(painter: _RingPainter(ring.value));
                },
              ),
            ),
            AnimatedContainer(
              duration: const Duration(milliseconds: 160),
              curve: Curves.ease,
              width: dot,
              height: dot,
              decoration: BoxDecoration(
                color: shutterRed,
                borderRadius: BorderRadius.circular(radius),
              ),
            ),
          ],
        ),
      ),
    );
  }
}

class _RingPainter extends CustomPainter {
  const _RingPainter(this.progress);

  final double progress;

  @override
  void paint(Canvas canvas, Size size) {
    // SVG は viewBox 100 のなかに r=45・stroke-width 6 で描かれている
    final double k = size.width / 100;
    final Offset center = Offset(size.width / 2, size.height / 2);
    final double r = 45 * k;
    final double width = 6 * k;

    final Paint track = Paint()
      ..style = PaintingStyle.stroke
      ..strokeWidth = width
      ..color = const Color(0x52FFFFFF);          // rgba(255,255,255,.32)
    canvas.drawCircle(center, r, track);

    if (progress <= 0) return;

    final Paint run = Paint()
      ..style = PaintingStyle.stroke
      ..strokeWidth = width
      ..strokeCap = StrokeCap.round
      ..color = light;
    // CSS 側は svg ごと -90deg 回してあるので、真上から時計回りに伸びる
    canvas.drawArc(
      Rect.fromCircle(center: center, radius: r),
      -math.pi / 2,
      2 * math.pi * progress,
      false,
      run,
    );
  }

  @override
  bool shouldRepaint(_RingPainter old) => old.progress != progress;
}

// ── 撮ったあとの帯 ──────────────────────────────────────
class _ReviewBar extends StatelessWidget {
  const _ReviewBar({required this.onRetake});

  final VoidCallback onRetake;

  @override
  Widget build(BuildContext context) {
    return Container(
      padding: const EdgeInsets.all(s3),
      color: reviewBackdrop,
      child: Row(
        children: <Widget>[
          _TextButton('撮り直し', onTap: onRetake),
          const SizedBox(width: s3),
          const Expanded(child: _NoteInput()),
          const SizedBox(width: s3),
          const _PrimaryButton('保存'),
        ],
      ),
    );
  }
}

/// CSS: .btn — 囲まない。文字と下線だけ。押せる高さは 44px。
class _TextButton extends StatelessWidget {
  const _TextButton(this.text, {this.onTap});

  final String text;
  final VoidCallback? onTap;

  @override
  Widget build(BuildContext context) {
    return GestureDetector(
      onTap: onTap,
      behavior: HitTestBehavior.opaque,
      child: ConstrainedBox(
        constraints: const BoxConstraints(minHeight: 44),
        child: Center(
          widthFactor: 1,
          child: Text(
            text.toUpperCase(),
            style: TextStyle(
              color: const Color(0xD9FFFFFF),          // rgba(255,255,255,.85)
              fontFamily: monoFamily,
              fontFamilyFallback: monoFallback,
              fontSize: 11,
              height: lineHeight,
              letterSpacing: tracking(11, .16),        // --track
              decoration: TextDecoration.underline,
              decorationColor: const Color(0x8CFFFFFF),
            ),
          ),
        ),
      ),
    );
  }
}

/// CSS: .btn.primary — 強調は反転（白地に黒）で行う。色は足さない。
class _PrimaryButton extends StatelessWidget {
  const _PrimaryButton(this.text);

  final String text;

  @override
  Widget build(BuildContext context) {
    return ConstrainedBox(
      constraints: const BoxConstraints(minHeight: 44),
      child: Container(
        color: light,
        padding: const EdgeInsets.symmetric(horizontal: s3, vertical: 10),
        alignment: Alignment.center,
        child: Text(
          text.toUpperCase(),
          style: const TextStyle(
            color: Color(0xFF000000),
            fontFamily: monoFamily,
            fontFamilyFallback: monoFallback,
            fontSize: 11,
            height: lineHeight,
            letterSpacing: 1.76,                       // 11px × .16em
          ),
        ),
      ),
    );
  }
}

/// CSS: .review-bar input — 囲みは作らず、下の 1 本だけで書く場所を示す。
class _NoteInput extends StatelessWidget {
  const _NoteInput();

  @override
  Widget build(BuildContext context) {
    return Container(
      padding: const EdgeInsets.symmetric(vertical: 8),
      decoration: const BoxDecoration(
        border: Border(bottom: BorderSide(color: Color(0x4DFFFFFF))),
      ),
      child: TextField(
        style: const TextStyle(color: light, fontSize: 15, height: lineHeight),
        cursorColor: light,
        decoration: const InputDecoration(
          isDense: true,
          border: InputBorder.none,
          contentPadding: EdgeInsets.zero,
          hintText: 'ひとこと（任意）',
          hintStyle: TextStyle(color: Color(0x80FFFFFF), fontSize: 15, height: lineHeight),
        ),
      ),
    );
  }
}
