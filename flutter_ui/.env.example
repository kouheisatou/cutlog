# cutlog（Flutter）の設え。
# ★ 秘密は入れない。ここに書くのは「どこへつなぐか」だけ。
#   秘密が要るもの（Firebase の鍵など）は、各 OS の設定ファイルに置く。

# つなぎ先のサーバ。
#   空 …… web で、同じ出どころから配られているとき（いちばん普通）
#   http://localhost:8787 …… iOS シミュレータ / Android エミュレータから母艦を見るとき
#     ※ Android エミュレータは http://10.0.2.2:8787
#   https://... …… 実機。localhost は端末自身を指すので、母艦の住所か Tailscale の名前を書く
CUTLOG_BASE=

# 組み立てのときに --dart-define=CUTLOG_BASE=... を渡すと、こちらが優先される。
