# ネイティブの殻（android / ios）がつなぐ先。
#
# このファイルを native.env という名前でコピーし、自分のサーバの住所を書く。
# 値はビルドのときに埋め込まれる。アプリの中で入力させることはしない。
#
#   cp native.env.example native.env
#
# native.env は git に入れない（住所は環境ごとに違うため）。

# 例: https://cutlog.example.com  /  https://appserver.tail7ca50.ts.net:8787
CUTLOG_BASE_URL=https://appserver.tail7ca50.ts.net:8787

# アプリの表示名（省略時は cutlog）
CUTLOG_APP_NAME=cutlog
