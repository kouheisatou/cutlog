# ── 基本 ─────────────────────────────────────────────
# 公開するURL（OIDCのコールバックと共有リンクに使う）
BASE_URL=http://localhost:8787
PORT=8787
INSTANCE_NAME=cutlog
# リバースプロキシ（Nginx / Caddy / Cloudflare）の後ろに置くなら true
TRUST_PROXY=false
# HTTPSで公開するなら true（Cookieに Secure が付く）
COOKIE_SECURE=false
# メディアとSQLiteの置き場所（既定はリポジトリ内の ./data）
# DATA_DIR=./data

# ── データベース ─────────────────────────────────────
# sqlite（既定・設定不要）か postgres
DB_DRIVER=sqlite
# DB_DRIVER=postgres のときだけ使う
# DATABASE_URL=postgres://cutlog:cutlog@postgres:5432/cutlog

# ── メディアの保存先 ─────────────────────────────────
# local（既定）か s3（S3互換。MinIO・R2・AWS S3）
STORAGE_DRIVER=local
# S3_BUCKET=cutlog
# S3_REGION=auto
# S3_ENDPOINT=http://minio:9000
# S3_ACCESS_KEY_ID=cutlog
# S3_SECRET_ACCESS_KEY=cutlogcutlog
# S3_FORCE_PATH_STYLE=true
# S3_PREFIX=cutlog

# ── 認証 ─────────────────────────────────────────────
# IDとパスワードでのログインを使うか
AUTH_LOCAL_ENABLED=true
# 誰でも新規登録できるか（社内で閉じるなら false。最初の1人は必ず作れる）
AUTH_OPEN_SIGNUP=true
# 管理者にするユーザー名（カンマ区切り。最初に登録した人は自動で管理者）
# ADMIN_USERNAMES=admin

# ── シングルサインオン（OIDC）───────────────────────
# ここを書くだけで、ログイン画面にボタンが出る。
#
# Google の例:
#   1. Google Cloud コンソール → APIとサービス → 認証情報 → OAuth クライアントID（ウェブ）
#   2. 承認済みのリダイレクトURI に  <BASE_URL>/api/auth/oidc/callback  を登録
#   3. 下の3つを書く
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# OIDC_CLIENT_SECRET=xxxxxxxx
# OIDC_BUTTON_LABEL=Googleで入る
# 会社のドメインだけ通す（カンマ区切り）
# OIDC_ALLOWED_DOMAINS=example.co.jp
# 初めての人を自動で作るか
# OIDC_AUTO_CREATE_USERS=true
#
# Microsoft Entra ID の例:
# OIDC_ISSUER=https://login.microsoftonline.com/<テナントID>/v2.0
# Keycloak の例:
# OIDC_ISSUER=https://keycloak.example.com/realms/<realm>

# ── 通知（Web Push）─────────────────────────────────
# npm run vapid で作った鍵を貼る
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# ── iOS / Android のアプリへ通知を出す（Firebase）──────────────────────
# ブラウザ向けの VAPID とは別口。両方置けば、どちらにも届く。
#
#  1. Firebase のコンソールで企画（プロジェクト）を1つ作る
#  2. 「プロジェクトの設定 → サービス アカウント → 新しい秘密鍵の生成」で JSON を落とす
#  3. その JSON の道をここに書く（サーバの外から読めない場所に置くこと）
#  4. iOS は「Cloud Messaging → APNs 認証キー」も要る（Apple の Developer から .p8 を作って上げる）
#
# アプリ側には、同じ企画から落とした設定ファイルを置く：
#   flutter_ui/android/app/google-services.json
#   flutter_ui/ios/Runner/GoogleService-Info.plist
#
# FCM_SERVICE_ACCOUNT_FILE=/etc/cutlog/firebase-service-account.json
# 中身をそのまま置くこともできる（1行の JSON）。ファイルを置けない場所ではこちら。
# FCM_SERVICE_ACCOUNT_JSON=

# ── メディアとまとめ動画 ─────────────────────────────
MAX_UPLOAD_MB=200
CUT_SECONDS_DEFAULT=2
RENDER_ENABLED=true
# 何本まで同時にffmpegを走らせるか
RENDER_CONCURRENCY=1
# 複数台に分けるとき、この台をワーカーにするか
RENDER_WORKER=true
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# まとめ動画に焼き込む文字のフォントファイル（空ならffmpegが持っている既定のフォントを使う）
# RENDER_FONT_FILE=/data/fonts/NotoSansJP-Regular.otf

# ── その他 ───────────────────────────────────────────
SESSION_DAYS=90
RATE_LIMIT_WRITE_PER_MINUTE=120
# 何日でカットを自動で消すか（0なら消さない。自動削除はv0.3で実装します）
# MEDIA_RETENTION_DAYS=0

# ── 地図 ─────────────────────────────────────────────
# 撮った場所を出すときの、地図の絵（タイル）の出どころ。
# 空にすると外へ取りに行かず、印だけの地図になる。
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_CREDIT=© OpenStreetMap contributors
